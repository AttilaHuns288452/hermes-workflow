# =============================================================================
# Hermes Workflow — .env.example
# =============================================================================
# Copy this file to .env and fill in your values.
# The pipeline reads these variables to configure MCP servers,
# model providers, and local tool paths.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your settings
#   source .env          # (bash) or set via Hermes config
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — User identity
# ---------------------------------------------------------------------------
HERMES_USERNAME="YOUR_USERNAME"
# Your system username. Used to construct paths in config templates.
# On Windows: set to your C:\Users\<name> folder name.

HERMES_PROJECTS_ROOT="$HOME/Documents/Projects"
# Root directory where all your code projects live.

# ---------------------------------------------------------------------------
# REQUIRED — Obsidian vault
# ---------------------------------------------------------------------------
OBSIDIAN_VAULT_PATH="$HOME/Documents/Obsidian Vault"
# Path to your Obsidian vault folder. The note-taking skills create,
# read, and link notes here. Must exist before running the pipeline.

# ---------------------------------------------------------------------------
# REQUIRED (if using LLMQuant skills) — API keys
# ---------------------------------------------------------------------------
LLMQUANT_API_KEY="lqd_data_YOUR_API_KEY_HERE"
# LLMQuant Data API key for financial data feeds.
# Get one at https://llmquant.com

# ---------------------------------------------------------------------------
# OPTIONAL — FreeLLMAPI proxy (Layer 3 of the free model chain)
# ---------------------------------------------------------------------------
# FreeLLMAPI is a local proxy that aggregates 107 free models from 16
# providers behind one OpenAI-compatible endpoint.
#
# First-time setup:
#   1. Clone & install: git clone https://github.com/tashfeenahmed/freellmapi.git
#                        cd freellmapi && npm install
#   2. Start both services: npm run dev
#      - API backend on http://localhost:3001/v1
#      - Admin dashboard on http://localhost:5173
#   3. Open http://localhost:5173 in browser
#   4. Create admin account (first signup creates the admin)
#   5. Go to Settings → copy the "Unified API Key"
#   6. Add upstream provider keys (Google, Groq, etc.) via Keys page
#   7. Set the key below (or use: hermes auth add freellmapi --type api-key --api-key <key>)
#
# Default dashboard login: admin@freellmapi.local / freellmapi-admin
# ---------------------------------------------------------------------------
FREELLMAPI_HOST="localhost"
FREELLMAPI_PORT="3001"
FREELLMAPI_BASE_URL="http://${FREELLMAPI_HOST}:${FREELLMAPI_PORT}/v1"
FREELMAPI_API_KEY=""
# Your unified API key from http://localhost:5173/settings
# Required for Hermes to authenticate with FreeLLMAPI.
# You can also set it via: hermes auth add freellmapi --type api-key --api-key <key>

# ---------------------------------------------------------------------------
# OPTIONAL — OpenRouter API key (Layer 4 fallback)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
# Only needed if you want to use the OpenRouter :free tier as a fallback.
# Get one at https://openrouter.ai/keys

# ---------------------------------------------------------------------------
# OPTIONAL — Paid model provider keys (Layer 5, last resort)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GOOGLE_API_KEY=""
# Only needed if you want paid fallback when all free layers are exhausted.

# ---------------------------------------------------------------------------
# OPTIONAL — Path overrides for Windows
# ---------------------------------------------------------------------------
# NPM_PATH="/c/Users/YOUR_USERNAME/AppData/Roaming/npm"
# LOCAL_BIN_PATH="/c/Users/YOUR_USERNAME/.local/bin"
# NODE_PATH="/c/Program Files/nodejs"
# Uncomment and adjust if your tool paths differ from the defaults
# used in config.yaml.template.

# ---------------------------------------------------------------------------
# OPTIONAL — CodeGraph behaviour
# ---------------------------------------------------------------------------
CODEGRAPH_WATCH="true"
# Set to "true" to auto-watch file changes when CodeGraph MCP is running.

# ---------------------------------------------------------------------------
# OPTIONAL — Graphify
# ---------------------------------------------------------------------------
GRAPHIFY_PROJECTS_ROOT="$HERMES_PROJECTS_ROOT"
# Root directory that Graphify scans for project indices.

# ---------------------------------------------------------------------------
# OPTIONAL — Model routing preferences
# ---------------------------------------------------------------------------
FREE_MODEL_DEFAULT="deepseek-v4-flash-free"
# The default free model used by OpenCode (Layer 1).
# Options: deepseek-v4-flash-free, mimo-v2.5-free,
#          nemotron-3-ultra-free, north-mini-code-free, big-pickle

# ---------------------------------------------------------------------------
# OPTIONAL — Debug / verbosity
# ---------------------------------------------------------------------------
HERMES_LOG_LEVEL="info"
# Set to "debug" for verbose pipeline tracing.
