# Hermes Workflow environment-variable reference.
# This is a placeholder template, not a runtime environment file.
# Run `hermes config env-path` and merge only the variables you use; do not overwrite an existing file.
# Keep all real credentials in the active Hermes profile's environment file.

# Paths referenced by config.yaml.template
HERMES_WORKFLOW_ROOT=/path/to/hermes-workflow
HERMES_EXTERNAL_SKILLS_ROOT=/path/to/optional-skill-library

# Credentials required only when the matching MCP server is enabled
LLMQUANT_API_KEY=
FIRECRAWL_API_KEY=
FIGMA_API_KEY=

# Optional OpenDesign executable paths; its MCP example is disabled by default
OPENDESIGN_EXECUTABLE=
OPENDESIGN_DAEMON_CLI=

# Set model.key_env to your chosen provider's environment-variable name,
# then add that variable locally. Do not put a real key in this reference file.
