# =============================================================================
# Hermes Workflow — config.yaml.template
# =============================================================================
# Review and merge into the active profile config; never overwrite an existing profile.
# Use `hermes config path` and `hermes config env-path` to locate the active files.
# Hermes expands ${VAR_NAME} references from the profile .env; keep credentials there.
# Replace portable path placeholders for your operating system. Add API keys
# in the profile .env or Hermes auth, never in this file.
# This is a portable example, not a copy of any one live installation.
# =============================================================================
#
# Replace provider and path placeholders for your machine. Keep credentials in
# the active profile's environment file (see `hermes config env-path`) or the
# Hermes auth store. The template intentionally avoids
# embedding model IDs or vendor-specific defaults as operational promises.
#
# Portable path variables used below:
#   HERMES_WORKFLOW_ROOT          → absolute path to this checkout
#   HERMES_EXTERNAL_SKILLS_ROOT   → optional root for additional skill libraries
#
# Provider credentials are referenced by environment variable names only.

# Select a model/provider pair that exists in your installation.
# This placeholder is intentionally not an operational default.
model:
  default: YOUR_MODEL_ID
  provider: YOUR_PROVIDER_ID
  key_env: YOUR_PROVIDER_KEY_ENV
  # Add context_length only when required, using the selected model's verified limit.

providers:
  YOUR_PROVIDER_ID:
    base_url: https://YOUR_PROVIDER_HOST/v1
    default_model: YOUR_MODEL_ID
    key_env: YOUR_PROVIDER_KEY_ENV
    discover_models: false
  local-ollama:
    base_url: http://localhost:11434/v1
    default_model: YOUR_LOCAL_OLLAMA_MODEL
    discover_models: true

fallback_providers: []

toolsets: [hermes-cli]

# --- SKILLS ---------------------------------------------------------------
# Add only directories that exist on the target machine. Hermes expands ~ and
# ${ENV_VAR} in external_dirs. The repository checkout is the portable default.
skills:
  external_dirs:
    - ${HERMES_WORKFLOW_ROOT}/skills
    # - ${HERMES_EXTERNAL_SKILLS_ROOT}/superpowers/skills
    # - ${HERMES_EXTERNAL_SKILLS_ROOT}/agent-skills/skills
    # - ${HERMES_EXTERNAL_SKILLS_ROOT}/claude-seo/skills
    # - ${HERMES_EXTERNAL_SKILLS_ROOT}/obsidian-skills/skills

# --- MCP SERVERS -----------------------------------------------------------
# Every example is disabled by default. Enable a server only after installing,
# authenticating, and testing that exact integration on the target machine.
mcp_servers:
  codegraph:
    enabled: false
    command: codegraph
    args: [serve, --mcp]
    connect_timeout: 60
    timeout: 120
  llmquant-data:
    enabled: false
    command: npx
    args: ["-y", "@llmquant/data-mcp"]
    connect_timeout: 60
    env:
      LLMQUANT_API_KEY: ${LLMQUANT_API_KEY}
  opendesign:
    # Optional. Install OpenDesign first and replace these paths for the target OS.
    enabled: false
    command: ${OPENDESIGN_EXECUTABLE}
    args: ["${OPENDESIGN_DAEMON_CLI}", "mcp"] # portable argv; keep both entries quoted
    connect_timeout: 60
  firecrawl:
    enabled: false
    url: https://mcp.firecrawl.dev/${FIRECRAWL_API_KEY}/v2/mcp
    connect_timeout: 60
  figma-dev:
    enabled: false
    command: npx
    args: ["-y", "figma-developer-mcp", "--stdio"]
    connect_timeout: 90
    env:
      FIGMA_API_KEY: ${FIGMA_API_KEY}

# --- KANBAN ---------------------------------------------------------------
kanban:
  dispatch_in_gateway: true
  dispatch_interval_seconds: 60
  failure_limit: 2
  orchestrator_profile: default
  auto_decompose: true
  auto_decompose_per_tick: 3

# --- AUXILIARY MODELS -----------------------------------------------------
auxiliary:
  vision:
    provider: YOUR_VISION_PROVIDER_ID
    model: YOUR_VISION_MODEL_ID
  kanban_decomposer:
    provider: auto
    timeout: 180

# --- DELEGATION -----------------------------------------------------------
# Keep concurrency bounded. Increase only after measuring provider limits,
# child success rate, wall-clock time, and cost on your own workload.
delegation:
  model: YOUR_DELEGATION_MODEL_ID
  provider: YOUR_DELEGATION_PROVIDER_ID
  inherit_mcp_toolsets: true
  max_concurrent_children: 4
  max_spawn_depth: 1
  max_iterations: 50
  child_timeout_seconds: 600

# --- BACKUP ---------------------------------------------------------------
backup:
  quick: true
  cron: "0 3 * * *"
